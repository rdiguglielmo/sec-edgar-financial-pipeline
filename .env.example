# Copy this file to .env and fill in your own contact details.
#
# The SEC requires every automated client to identify itself. Requests without a
# declared User-Agent containing a real name and email are rejected with HTTP 403.
# See https://www.sec.gov/os/webmaster-faq#developers
#
# The SEC also enforces a limit of 10 requests per second. The extractor respects it.
SEC_USER_AGENT="Your Name your.email@example.com"
